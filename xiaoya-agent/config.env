# 对话智能体配置
# API配置
API_BASE_URL=https://api.deepseek.com
API_KEY=sk-9895d0792ac243a997fd9a56dafaf0b1
MODEL_NAME=deepseek-chat
DATA_DIR=data

# 对话配置
TEMPERATURE=0.7
MAX_TOKENS=1000
AGENT_GRAPH_ENABLED=true
AGENT_TOOLS_ENABLED=true
AGENT_MODEL_TOOL_CALLING_ENABLED=true
AGENT_MODEL_TOOL_CALL_MAX_CALLS=2
BACKGROUND_ANALYSIS_START_MODE=after_stream
BACKGROUND_CRISIS_FIRST_ENABLED=true
BACKGROUND_ANALYSIS_TIMEOUT_SECONDS=8
RESPONSE_MAX_TOKENS_NORMAL=240
RESPONSE_MAX_TOKENS_CBT=280
PROMPT_PROFILE=warm_cbt
OUTPUT_MODE=brief_support

# MCP 风格确定性服务
MCP_SERVICES_ENABLED=true
MCP_DIRECT_ANSWER_ENABLED=true
MCP_TIMEZONE=Asia/Shanghai

# RAG 检索配置：运行时只使用 Dify 知识库。File/ 仅作为项目参考资料，不参与 RAG。
RAG_ENABLED=true
# 以下 RAG_SOURCE_DIR / RAG_CHUNK_SIZE / RAG_EMBEDDING_* 为兼容旧配置保留；
# 运行时不会读取 File/，也不会建立本地 RAG 或本地向量索引。
RAG_SOURCE_DIR=File
RAG_TOP_K=3
RAG_CHUNK_SIZE=450
RAG_MAX_CONTEXT_CHARS=900
RAG_MIN_SCORE=0.08
RAG_SCORING_MODE=tfidf
RAG_AUTO_TRIGGER_ENABLED=true
RAG_WARMUP_ON_START=true
RAG_BACKEND=dify

# Dify 可替换项：
# Dify Chatflow/Workflow 可作为外层入口；Dify 知识库是唯一 RAG 检索后端。
# Dify 知识库是唯一 RAG 后端。检索失败时不会回退到 File/。
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=dataset-MxlMCuWp1ILama7cHi9f35Z0
DIFY_KNOWLEDGE_BASE_ID=6e0e04ca-8c7c-446f-b3e2-53ea7bd90a68
DIFY_KNOWLEDGE_ENABLED=true
DIFY_KNOWLEDGE_FALLBACK_TO_LOCAL=false
DIFY_KNOWLEDGE_TIMEOUT_SECONDS=8
DIFY_KNOWLEDGE_SEARCH_METHOD=keyword_search

# 系统提示
SYSTEM_PROMPT=你是一个专业的心理健康助手，采用认知行为疗法(CBT)的方法来帮助用户。你会倾听用户的问题，提供CBT视角的见解和建议，帮助用户识别和改变负面思维模式。

# CBT配置
CBT_ENABLED=true
AUTO_CBT_INTERVENTION=true
CBT_LLM_ENABLED=true
CBT_INTERVENTION_SEVERITY_THRESHOLD=6
CBT_DISTORTION_TRIGGER_ENABLED=true

# 危机干预配置
CRISIS_DETECTION_ENABLED=true
# 危机报警阈值：越高代表“更严重时才报警”，默认 10
CRISIS_ALERT_THRESHOLD=10
AUTO_SAVE_PROGRESS=true   # 自动保存进度

# 能量评估配置
ENERGY_MODEL_ENABLED=true
ENERGY_FEEDBACK_ENABLED=true  # 启用能量反馈

# 骨髓移植分期支持（task1）
TRANSPLANT_SUPPORT_ENABLED=true

# LLM 判定（心理/安全危机默认使用语义判断；关键词只作为可选医疗兜底）
CRISIS_LLM_DETECTION_ENABLED=true
CRISIS_LLM_STREAM_BLOCKING_ENABLED=false
MEDICAL_RED_FLAG_RULE_ENABLED=false
TRANSPLANT_LLM_SCENARIO_ENABLED=true
LLM_DETECTION_MODEL=deepseek-chat
LLM_DETECTION_TEMPERATURE=0.4
LLM_DETECTION_MAX_TOKENS=256
CRISIS_PRECHECK_MODEL=deepseek-chat
CRISIS_PRECHECK_TEMPERATURE=0.0
CRISIS_PRECHECK_MAX_TOKENS=96
CRISIS_PRECHECK_TIMEOUT_SECONDS=1.8

# 对话历史压缩配置（增量摘要/记忆中枢）
HISTORY_COMPRESSION_ENABLED=true  # 启用增量摘要
INCREMENTAL_SUMMARY_MAX_WORDS=300  # 增量摘要最大字数
POST_STREAM_ANALYSIS_WAIT_SECONDS=8  # 回复结束后等待后台分析完成，保证 done 中分析类字段完整

# 调试选项
DEBUG_MEMORY_CORE=false  # 是否打印记忆中枢更新日志
