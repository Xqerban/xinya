<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinya.business.hopetree.mapper.HopeTreeGrowthHistoryMapper">

    <select id="findByPatientIdOrderByCreatedAtDesc" resultType="com.xinya.business.hopetree.entity.HopeTreeGrowthHistory">
        SELECT * FROM hope_tree_growth_history
        WHERE patient_id = #{patientId}
        ORDER BY created_at DESC
    </select>

</mapper>
